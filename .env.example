# Server-only. Never use EXPO_PUBLIC_ for provider secrets.
OPENAI_API_KEY=
OPENAI_ACTOR_MODEL=gpt-5.6-luna
OPENAI_EVALUATOR_MODEL=gpt-5.6-luna
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=cedar
OPENAI_ALIGNMENT_MODEL=whisper-1
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe

# Use `fixture` only for deterministic local API-route testing.
ACTOR_PROVIDER=openai
EVALUATOR_PROVIDER=openai

# RevenueCat SDK keys are public app identifiers, not server secrets. The shared
# key below enables RevenueCat Test Store. Use separate platform keys for the
# App Store and Play Store before shipping.
EXPO_PUBLIC_REVENUECAT_API_KEY=test_lUWKKzTyWNQjyecJqkZfHfenPha
# EXPO_PUBLIC_RC_APPLE_API_KEY=appl_your_key
# EXPO_PUBLIC_REVENUECAT_ANDROID_API_KEY=goog_your_key
# EXPO_PUBLIC_REVENUECAT_WEB_API_KEY=rcb_your_key

# Public legal pages opened from Settings.
EXPO_PUBLIC_PRIVACY_URL=https://ajar-prune-18d.notion.site/The-Talk-Ahead-Privacy-Policy-3c799fdd69fc809f9c97ed2cac47ecb9?pvs=74
EXPO_PUBLIC_TERMS_URL=https://ajar-prune-18d.notion.site/The-Talk-Ahead-Terms-Of-Service-3c799fdd69fc8064a394f34afbe8831a?pvs=73

# PostHog public client configuration.
EXPO_PUBLIC_POSTHOG_PROJECT_TOKEN=phc_your_project_token_here
EXPO_PUBLIC_POSTHOG_HOST=https://your-posthog-host
